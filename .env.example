# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public origin of the site. Used for canonical URLs, hreflang and sitemaps.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Long random string used to sign Payload auth tokens.
# Generate with:  openssl rand -base64 32
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Database - Supabase Postgres
# ---------------------------------------------------------------------------
# Two connection strings, because the two workloads need different pooler modes.
# Both come from: Project Settings > Database > Connection string.
#
#   DATABASE_URI          Transaction pooler, port 6543. Used by the app and by
#                         the build. It multiplexes, so prerendering every page
#                         and running serverless functions cannot exhaust the
#                         connection budget.
#
#   DATABASE_URI_SESSION  Session pooler, port 5432. Used only by migrations,
#                         which need a real session. Capped at 15 clients for
#                         the whole project, shared across every environment
#                         at once - exceeding it fails the build with
#                         EMAXCONNSESSION mid-prerender.
#
# Run migrations with "pnpm migrate", which swaps in DATABASE_URI_SESSION.
#
# Do not use the direct host db.<ref>.supabase.co: it is IPv6-only, so it is
# unreachable from most networks without the IPv4 add-on (ENETUNREACH).
DATABASE_URI=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URI_SESSION=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Connections each instance may hold. Keep it small: the session pooler budget
# is shared, and every serverless instance opens its own pool.
DATABASE_POOL_MAX=4

# ---------------------------------------------------------------------------
# Supabase API keys
# ---------------------------------------------------------------------------
# Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co

# Project Settings > API Keys > Publishable key (sb_publishable_...).
# Safe in the browser; row level security governs what it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API Keys > Secret keys (sb_secret_...).
# Bypasses row level security. Server-side only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Media storage — Supabase Storage (S3 compatible)
# ---------------------------------------------------------------------------
# Leave all S3_* blank to store uploads on local disk under /media instead.
# Supabase dashboard > Project Settings > Storage > S3 Connection.
S3_BUCKET=media
S3_REGION=eu-central-1
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
RESEND_FROM_EMAIL=Tikvatlibenu <noreply@tikvatlibenu.co.il>
# Where contact form notifications land. Falls back to Site Settings > Contact.
CONTACT_NOTIFICATION_EMAIL=
